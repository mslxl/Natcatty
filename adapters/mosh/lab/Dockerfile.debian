# SPDX-License-Identifier: GPL-3.0-or-later
#
# Debian/Ubuntu mosh parity cell. The pinned upstream mosh release is built
# from source at image build time; no stock mosh code is stored in this
# repository. Build from the repository root via the gate:
#
#   go run ./internal/tools/moshparity run -cell debian-12/1.4.0 -build
#
# or directly:
#
#   docker build -f adapters/mosh/lab/Dockerfile.debian \
#     --build-arg BASE=debian:12 \
#     --build-arg MOSH_VERSION=1.4.0 \
#     --build-arg MOSH_SHA256=872e4b134e5df29c8933dff12350785054d2fd2839b5ae6b5587b14db1465ddd \
#     -t natcatty/mosh-lab-debian12:1.4.0 adapters/mosh/lab
ARG BASE=debian:12
FROM ${BASE}

ARG MOSH_VERSION=1.4.0
ARG MOSH_SHA256
ARG MOSH_URL=https://github.com/mobile-shell/mosh/releases/download/mosh-${MOSH_VERSION}/mosh-${MOSH_VERSION}.tar.gz

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl pkg-config \
      libssl-dev zlib1g-dev libprotobuf-dev protobuf-compiler \
      libncurses-dev openssh-server passwd locales \
 && sed -i '/^# *de_DE.UTF-8 UTF-8/s/^# *//' /etc/locale.gen \
 && locale-gen \
 && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "${MOSH_URL}" -o /tmp/mosh.tar.gz \
 && echo "${MOSH_SHA256}  /tmp/mosh.tar.gz" | sha256sum -c - \
 && mkdir -p /src \
 && tar -xzf /tmp/mosh.tar.gz -C /src \
 && cd "/src/mosh-${MOSH_VERSION}" \
 && CXXFLAGS="-std=c++17 -O2" ./configure --prefix=/usr/local --without-utempter \
 && make -j"$(nproc)" \
 && make install \
 && rm -f /tmp/mosh.tar.gz

RUN (id tester >/dev/null 2>&1 || useradd -m -s /bin/bash tester) \
 && echo 'tester:testpass' | chpasswd \
 && mkdir -p /run/sshd \
 && ssh-keygen -A

COPY sshd_config.lab /etc/ssh/sshd_config.lab
COPY lab-entrypoint.sh /usr/local/bin/mosh-lab-entrypoint
RUN chmod 0755 /usr/local/bin/mosh-lab-entrypoint

EXPOSE 22
ENTRYPOINT ["/usr/local/bin/mosh-lab-entrypoint"]
