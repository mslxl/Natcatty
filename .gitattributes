# Keep sources and CI files byte-identical across checkouts so gofmt, the i18n
# catalog diff, and the generated parity matrix behave the same on every OS.
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf

# The CSV import fixtures assert exact bytes (UTF-8 BOM, CRLF row endings), and
# the rest of the import fixture tree must stay byte-stable too. The JSON rule
# above still sets eol for these paths unless it is unset here as well.
domain/vaultimport/testdata/** -text -eol
app/testdata/selftest24/** -text -eol

*.png binary
*.ico binary
*.icns binary
