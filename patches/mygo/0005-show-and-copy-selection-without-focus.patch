+// copyTextSelection copies the current paragraph selection, in whichever
+// container it is, and reports whether there was one. The focus may have
+// moved out of the container since the drag — an app can take it back for a
+// control that keeps typing aimed elsewhere, as a terminal pane does — and
+// Edit › Copy and its shortcut still act on the selection the user sees.
+func (rt *engine) copyTextSelection() bool {
+	a, b, selected := rt.textSelectionBounds()
+	if !selected {
+		return false
+	}
+	scope := rt.selection.scope
+	if sc := rt.states[scope]; sc != nil && sc.copyData != nil {
+		rt.host.writeClipboardData(sc.copyData(rt.selectedTexts(scope)))
+		return true
+	}
+	var out strings.Builder
+	first, last := rt.textPointIndex(a), rt.textPointIndex(b)
+	wrote := false
+	for i := first; i <= last; i++ {
