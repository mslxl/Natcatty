 // its source set, with the splash screen's color.
 const androidSplashTheme = "Theme.MyGo.Splash"
 
+// androidNetworkSecurityConfig is the resource the manifest's
+// android:networkSecurityConfig names when the app declares cleartext hosts.
+const androidNetworkSecurityConfig = "mygo_network_security"
+
+// writeAndroidNetworkSecurity writes the configuration that permits cleartext
+// only to the hosts the app names. Every other host is refused, as Android's
+// default from target API 28 on does.
+func writeAndroidNetworkSecurity(res string, domains []string) error {
+	var b strings.Builder
+	b.WriteString(`<?xml version="1.0" encoding="utf-8"?>
+<network-security-config>
+    <base-config cleartextTrafficPermitted="false" />
+    <domain-config cleartextTrafficPermitted="true">
+`)
+	for _, d := range domains {
+		fmt.Fprintf(&b, "        <domain includeSubdomains=\"false\">%s</domain>\n", d)
+	}
+	b.WriteString(`    </domain-config>
+</network-security-config>
+`)
+	return writeResFiles(res, map[string]string{
+		filepath.Join("xml", androidNetworkSecurityConfig+".xml"): b.String(),
+	})
+}
