+func TestAndroidCleartextDomains(t *testing.T) {
+	// Without hosts the manifest keeps the system default: no attribute,
+	// no resource.
+	c := &Config{}
+	if m := string(androidManifest(c, nil)); strings.Contains(m, "networkSecurityConfig") {
+		t.Errorf("a manifest without cleartext hosts names a configuration:\n%s", m)
+	}
+
+	c.Android.CleartextDomains = []string{"127.0.0.1", "127.0.0.2"}
+	m := string(androidManifest(c, nil))
+	if !strings.Contains(m, `android:networkSecurityConfig="@xml/`+androidNetworkSecurityConfig+`"`) {
+		t.Errorf("no network security configuration in:\n%s", m)
+	}
+	// The attribute must be on <application>, not a child: only a start-tag
+	// attribute reaches Android's manifest.
+	if !strings.Contains(m, `android:theme="@style/Theme.MyGo"`+"\n        "+`android:networkSecurityConfig=`) {
+		t.Errorf("the configuration is not an <application> attribute:\n%s", m)
+	}
+
+	dir := t.TempDir()
+	if err := writeAndroidNetworkSecurity(dir, c.Android.CleartextDomains); err != nil {
+		t.Fatal(err)
+	}
+	xml, err := os.ReadFile(filepath.Join(dir, "xml", androidNetworkSecurityConfig+".xml"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := string(xml)
+	for _, want := range []string{
+		`<base-config cleartextTrafficPermitted="false" />`,
+		`<domain-config cleartextTrafficPermitted="true">`,
+		`<domain includeSubdomains="false">127.0.0.1</domain>`,
+		`<domain includeSubdomains="false">127.0.0.2</domain>`,
+	} {
+		if !strings.Contains(s, want) {
+			t.Errorf("no %s in:\n%s", want, s)
+		}
+	}
+}
