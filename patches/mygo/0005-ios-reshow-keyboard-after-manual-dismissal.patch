@@ -402,6 +421,14 @@ final class SurfaceWindow: HostWindow, UITextInput, UIPointerInteractionDelegate
 
     override func resignFirstResponder() -> Bool {
         let r = super.resignFirstResponder()
+        if editing && r && UIApplication.shared.applicationState == .active {
+            // The keyboard's own dismiss key resigns the view while the app
+            // stays active. Go then resizes the surface as the keyboard
