+// A download's metadata reaches the shared handler, and the path it
+// chooses goes back to the host.
+func TestDownloadEvents(t *testing.T) {
+	b, h := startBackend(t)
+	started := make(chan bool, 1)
+	finished := make(chan bool, 1)
+	wh := &winHandler{
+		download: func(url, suggested string) string {
+			started <- url == "https://example.com/files/a.bin" && suggested == "a.bin"
+			return "/tmp/a.bin"
+		},
+		downloaded: func(url, path string, err error) {
+			finished <- url == "https://example.com/files/a.bin" && path == "/tmp/a.bin" && err == nil
+		},
+	}
+	onMain(b, func() {
+		if _, err := b.NewWindow(&platform.WindowOptions{}, wh); err != nil {
+			t.Error(err)
+		}
+	})
+	var reply []byte
+	h.onUI(func() {
+		reply = deliver(encodeEvent(func(w *wire.Writer) {
+			w.Uvarint(wire.EventWillDownload)
+			w.Int(1)
+			w.String("https://example.com/files/a.bin")
+			w.String("a.bin")
+		}), true)
+	})
+	if path := (&wire.Reader{Buf: reply}).String(); path != "/tmp/a.bin" {
+		t.Errorf("WillDownload path = %q, want the handler's", path)
+	}
+	if !wait.For(t, "DownloadStarted", started) {
+		t.Errorf("DownloadStarted got the wrong metadata")
+	}
+
+	h.onUI(func() {
+		deliver(encodeEvent(func(w *wire.Writer) {
+			w.Uvarint(wire.EventDownloadDone)
+			w.Int(1)
+			w.String("https://example.com/files/a.bin")
+			w.String("/tmp/a.bin")
+			w.String("")
+		}), true)
+	})
+	if !wait.For(t, "DownloadFinished", finished) {
+		t.Errorf("DownloadFinished got the wrong metadata")
+	}
+}
