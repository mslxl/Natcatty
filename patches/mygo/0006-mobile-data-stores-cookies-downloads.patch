+    /**
+     * Downloads url to path, with the page's cookies, and tells Go how it
+     * ended. Android's web view downloads nothing by itself.
+     */
+    private fun download(url: String, userAgent: String, path: String) {
+        Thread {
+            try {
+                val f = File(path)
+                f.parentFile?.mkdirs()
+                val c = URL(url).openConnection() as HttpURLConnection
+                c.instanceFollowRedirects = true
+                if (userAgent.isNotEmpty()) c.setRequestProperty("User-Agent", userAgent)
+                try {
+                    HostImpl.cookieManager(store).getCookie(url)?.let { c.setRequestProperty("Cookie", it) }
+                } catch (_: Exception) {
+                }
+                val code = c.responseCode
+                if (code !in 200..299) throw java.io.IOException("HTTP $code")
+                c.inputStream.use { input -> f.outputStream().use { input.copyTo(it) } }
+                Go.send(Event.downloadDone(id, url, path, ""))
+            } catch (e: Exception) {
+                Go.send(Event.downloadDone(id, url, path, e.message ?: e.toString()))
+            }
+        }.start()
+    }
