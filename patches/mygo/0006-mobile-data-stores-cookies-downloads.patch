+        props[.value] = c.value
+        guard let cookie = HTTPCookie(properties: props) else {
+            Go.send(Event.dataStoreDone(req: c.req, error: "mygo: cookies: Set could not construct the cookie"))
+            return
+        }
+        dataStore(c.store).httpCookieStore.setCookie(cookie) {
+            Go.send(Event.dataStoreDone(req: c.req, error: ""))
+        }
+    }
