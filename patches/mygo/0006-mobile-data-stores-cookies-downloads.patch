+    /** Eight strings per cookie, as the wire carries them. */
+    override fun listCookies(c: ListCookiesCall) {
+        if (c.url.isEmpty()) {
+            // Android enumerates no cookie without a URL to ask for.
+            Go.send(Event.cookiesListed(c.req, emptyList(), "mygo: Android lists cookies for a URL only"))
+            return
+        }
+        val header = try {
+            cookieManager(c.store).getCookie(c.url) ?: ""
+        } catch (e: Throwable) {
+            Go.send(Event.cookiesListed(c.req, emptyList(), "mygo: ${e.message ?: e.toString()}"))
+            return
+        }
+        val uri = Uri.parse(c.url)
+        val domain = uri.host ?: ""
+        val secure = uri.scheme.equals("https", true)
+        val fields = ArrayList<String>()
+        for (part in header.split(';')) {
+            val pair = part.trim()
+            val i = pair.indexOf('=')
+            if (i <= 0) continue
+            // Attributes unknown: Android gives a URL its Cookie header only.
+            fields.addAll(listOf(pair.substring(0, i), pair.substring(i + 1), domain, "/", "", "",
+                if (secure) "1" else "", ""))
+        }
+        Go.send(Event.cookiesListed(c.req, fields, ""))
+    }
