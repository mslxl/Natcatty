--- /dev/null
+++ b/internal/mobile/datastore.go
@@ -0,0 +1,210 @@
+package mobile
+
+import (
+	"errors"
+	"net/url"
+	"strings"
+	"time"
+
+	"github.com/egoist/mygo/internal/mobile/wire"
+	"github.com/egoist/mygo/internal/platform"
+)
+
+// dataStore is a website data store the host made: cookies, local and
+// session storage, IndexedDB, caches and service workers that the pages
+// using it share, apart from those of other stores. Its id names it in
+// calls of the host and in CreateWindow.
+type dataStore struct {
+	b  *Backend
+	id int
+}
+
+// Close lets the store go. The core calls it on the main thread when no
+// page uses an ephemeral store.
+func (s *dataStore) Close() {
+	if s == nil || s.b == nil {
+		return
+	}
+	s.b.call(&wire.CloseDataStore{Store: s.id}, nil)
+}
+
+// storeID returns the host's number of store, 0 for the default store.
+func storeID(store platform.DataStore) int {
+	if s, ok := store.(*dataStore); ok && s != nil {
+		return s.id
+	}
+	return 0
+}
+
+// awaitReply waits for an answer the host sends an event for. On the
+// main thread it keeps handling events, as platform.await does, so that
+// the host can answer while the core waits.
+func awaitReply[T any](b *Backend, ch <-chan T) T {
+	if !b.IsMainThread() {
+		return <-ch
+	}
+	for {
+		select {
+		case v := <-ch:
+			return v
+		default:
+		}
+		if b.quit.Load() {
+			var zero T
+			return zero
+		}
+		b.Step()
+	}
+}
+
+// NewDataStore makes a website data store in the host. Main thread only.
+func (a appController) NewDataStore(opts platform.DataStoreOptions) (platform.DataStore, error) {
+	if a.b == nil || a.b.t == nil {
+		return nil, errors.New("mygo: the app runs outside its host")
+	}
+	id := int(a.b.nextStore.Add(1))
+	ch := make(chan string, 1)
+	req := a.b.request(func(r wire.Reader) {
+		var e wire.DataStoreCreatedEvent
+		e.Decode(&r)
+		ch <- e.Error
+	})
+	a.b.call(&wire.NewDataStore{Req: req, Store: id, ID: opts.ID, Ephemeral: opts.Ephemeral,
+		DataDir: opts.DataDir, CacheDir: opts.CacheDir}, nil)
+	if msg := awaitReply(a.b, ch); msg != "" {
+		return nil, errors.New(msg)
+	}
+	return &dataStore{b: a.b, id: id}, nil
+}
+
+// ClearBrowsingData removes the site data of types from store.
+func (a appController) ClearBrowsingData(store platform.DataStore, types platform.SiteData, done func(error)) {
+	a.b.dataStoreCall(func(req int) {
+		a.b.call(&wire.ClearBrowsingData{Req: req, Store: storeID(store), Types: int(types)}, nil)
+	}, done)
+}
+
+// ListCookies lists the cookies of store, those a request to rawURL sends
+// unless it is empty. The host returns all it has; the URL matching is
+// done here, as WebKit's store cannot.
+func (a appController) ListCookies(store platform.DataStore, rawURL string, done func([]platform.Cookie, error)) {
+	var u *url.URL
+	if rawURL != "" {
+		var err error
+		if u, err = url.Parse(rawURL); err != nil {
+			done(nil, err)
+			return
+		}
+	}
+	ch := make(chan wire.CookiesListedEvent, 1)
+	req := a.b.request(func(r wire.Reader) {
+		var e wire.CookiesListedEvent
+		e.Decode(&r)
+		ch <- e
+	})
+	a.b.call(&wire.ListCookies{Req: req, Store: storeID(store), URL: rawURL}, nil)
+	e := awaitReply(a.b, ch)
+	cookies, err := decodeCookies(e.Cookies)
+	if err == nil && e.Error != "" {
+		err = errors.New(e.Error)
+	}
+	if err != nil {
+		done(nil, err)
+		return
+	}
+	out := cookies[:0]
+	for _, c := range cookies {
+		if u == nil || platform.CookieMatchesURL(c, u) {
+			out = append(out, c)
+		}
+	}
+	done(out, nil)
+}
+
+// SetCookie sets c in store.
+func (a appController) SetCookie(store platform.DataStore, c platform.Cookie, done func(error)) {
+	a.b.dataStoreCall(func(req int) {
+		expires := ""
+		if !c.Expires.IsZero() {
+			expires = c.Expires.UTC().Format(time.RFC3339)
+		}
+		a.b.call(&wire.SetCookie{Req: req, Store: storeID(store), Name: c.Name, Value: c.Value,
+			Domain: c.Domain, Path: c.Path, Expires: expires, Secure: c.Secure, HTTPOnly: c.HTTPOnly,
+			SameSite: strings.ToLower(c.SameSite)}, nil)
+	}, done)
+}
+
+// DeleteCookie deletes the cookie key names from store.
+func (a appController) DeleteCookie(store platform.DataStore, key platform.CookieKey, done func(error)) {
+	a.b.dataStoreCall(func(req int) {
+		a.b.call(&wire.DeleteCookie{Req: req, Store: storeID(store), Name: key.Name, Domain: key.Domain, Path: key.Path}, nil)
+	}, done)
+}
+
+// ClearCookies deletes every cookie of store, and nothing else it keeps.
+func (a appController) ClearCookies(store platform.DataStore, done func(error)) {
+	a.b.dataStoreCall(func(req int) {
+		a.b.call(&wire.ClearCookies{Req: req, Store: storeID(store)}, nil)
+	}, done)
+}
+
+// dataStoreCall sends a call that DataStoreDone answers, and reports its
+// error to done. Main thread only.
+func (b *Backend) dataStoreCall(send func(req int), done func(error)) {
+	ch := make(chan string, 1)
+	req := b.request(func(r wire.Reader) {
+		var e wire.DataStoreDoneEvent
+		e.Decode(&r)
+		ch <- e.Error
+	})
+	send(req)
+	if msg := awaitReply(b, ch); msg != "" {
+		done(errors.New(msg))
+		return
+	}
+	done(nil)
+}
+
+// cookiesOf encodes cookies as the host passes them: eight strings each,
+// name, value, domain, path, expires (RFC 3339, empty for a session
+// cookie), same site, secure and HTTPOnly ("1" or "").
+func cookiesOf(cookies []platform.Cookie) []string {
+	out := make([]string, 0, len(cookies)*8)
+	for _, c := range cookies {
+		expires := ""
+		if !c.Expires.IsZero() {
+			expires = c.Expires.UTC().Format(time.RFC3339)
+		}
+		out = append(out, c.Name, c.Value, c.Domain, c.Path, expires, strings.ToLower(c.SameSite),
+			flag(c.Secure), flag(c.HTTPOnly))
+	}
+	return out
+}
+
+// decodeCookies reads what cookiesOf wrote.
+func decodeCookies(fields []string) ([]platform.Cookie, error) {
+	if len(fields)%8 != 0 {
+		return nil, errors.New("mygo: cookies: the host sent an incomplete cookie")
+	}
+	out := make([]platform.Cookie, 0, len(fields)/8)
+	for i := 0; i+8 <= len(fields); i += 8 {
+		var expires time.Time
+		if s := fields[i+4]; s != "" {
+			t, err := time.Parse(time.RFC3339, s)
+			if err != nil {
+				return nil, err
+			}
+			expires = t
+		}
+		out = append(out, platform.Cookie{Name: fields[i], Value: fields[i+1], Domain: fields[i+2], Path: fields[i+3],
+			Expires: expires, SameSite: fields[i+5], Secure: fields[i+6] == "1", HTTPOnly: fields[i+7] == "1"})
+	}
+	return out, nil
+}
+
+func flag(v bool) string {
+	if v {
+		return "1"
+	}
+	return ""
+}
