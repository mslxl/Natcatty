+    override fun newDataStore(c: NewDataStoreCall) {
+        // Android isolates pages by WebView profile (MULTI_PROFILE), which
+        // older WebViews do not have: the entry stays closed there.
+        if (!WebViewFeature.isFeatureSupported(WebViewFeature.MULTI_PROFILE)) {
+            Go.send(Event.dataStoreCreated(c.req, c.store, "mygo: this device's WebView has no profiles"))
+            return
+        }
+        val name = when {
+            c.ephemeral -> "mygo-ephemeral-" + System.nanoTime()
+            c.id.isNotEmpty() -> c.id
+            else -> "mygo-" + c.store
+        }
+        try {
+            ProfileStore.getInstance().getOrCreateProfile(name)
+            dataStores[c.store] = name
+            if (c.ephemeral) ephemeralStores.add(c.store)
+            Go.send(Event.dataStoreCreated(c.req, c.store, ""))
+        } catch (e: Throwable) {
+            Go.send(Event.dataStoreCreated(c.req, c.store, "mygo: ${e.message ?: e.toString()}"))
+        }
+    }
+
+    override fun closeDataStore(c: CloseDataStoreCall) {
+        val name = dataStores.remove(c.store) ?: return
+        if (ephemeralStores.remove(c.store)) {
+            try {
+                ProfileStore.getInstance().deleteProfile(name)
+            } catch (_: Throwable) {
+            }
+        }
+    }
