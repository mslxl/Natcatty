+func cookieList(t *testing.T, b *Backend, store platform.DataStore, url string) []platform.Cookie {
+	t.Helper()
+	var got []platform.Cookie
+	var err error
+	onMain(b, func() {
+		b.App().ListCookies(store, url, func(c []platform.Cookie, e error) { got, err = c, e })
+	})
+	if err != nil {
+		t.Fatalf("ListCookies: %v", err)
+	}
+	return got
+}
