+package mobile
+
+import (
+	"slices"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/egoist/mygo/internal/mobile/wire"
+	"github.com/egoist/mygo/internal/platform"
+	"github.com/egoist/mygo/internal/wait"
+)
+
+// fakeStores is a host's website data stores: the stores it made, and
+// their cookies, apart from one another.
+type fakeStores struct {
+	mu       sync.Mutex
+	stores   []int
+	opts     []platform.DataStoreOptions
+	cookies  map[int]map[platform.CookieKey]platform.Cookie
+	closed   []int
+	cleared  []platform.SiteData
+	windowSt []int
+}
+
+func newFakeStores() *fakeStores {
+	return &fakeStores{cookies: map[int]map[platform.CookieKey]platform.Cookie{}}
+}
+
+// serve answers the calls of the data store and cookie protocol on the
+// fake host's UI thread, as the Swift and Kotlin hosts do.
+func (f *fakeStores) serve(op uint64, r *wire.Reader) {
+	switch op {
+	case wire.CallNewDataStore:
+		req, store := int(r.Int()), int(r.Int())
+		o := platform.DataStoreOptions{ID: r.String(), Ephemeral: r.Bool(), DataDir: r.String(), CacheDir: r.String()}
+		f.mu.Lock()
+		f.stores = append(f.stores, store)
+		f.opts = append(f.opts, o)
+		f.cookies[store] = map[platform.CookieKey]platform.Cookie{}
+		f.mu.Unlock()
+		deliver(encodeEvent(func(w *wire.Writer) {
+			w.Uvarint(wire.EventDataStoreCreated)
+			w.Int(req)
+			w.Int(store)
+			w.String("")
+		}), true)
+	case wire.CallCloseDataStore:
+		store := int(r.Int())
+		f.mu.Lock()
+		f.closed = append(f.closed, store)
+		delete(f.cookies, store)
+		f.mu.Unlock()
+	case wire.CallCreateWindow:
+		// The store is the last field of CreateWindow.
+		r.Int()        // ID
+		r.Bool()       // Surface
+		r.Bool()       // OwnScene
+		r.Int()        // Background
+		r.Bool()       // HasBackground
+		r.Strings()    // Schemes
+		r.Strings()    // Scripts
+		r.Strings()    // ScriptFlags
+		_ = r.String() // UserAgent
+		_ = r.String() // UserAgentSuffix
+		r.Bool()       // Inspectable
+		r.Bool()       // Autoplay
+		r.Bool()       // SwipeNavigation
+		r.Bool()       // PinchZoom
+		r.Int()        // Parent
+		_ = r.String() // ViewType
+		_ = r.String() // ViewArgs
+		store := int(r.Int())
+		f.mu.Lock()
+		f.windowSt = append(f.windowSt, store)
+		f.mu.Unlock()
+	case wire.CallListCookies:
+		req, store, _ := int(r.Int()), int(r.Int()), r.String()
+		f.mu.Lock()
+		var fields []string
+		for _, c := range f.cookies[store] {
+			fields = append(fields, cookiesOf([]platform.Cookie{c})...)
+		}
+		f.mu.Unlock()
+		deliver(encodeEvent(func(w *wire.Writer) {
+			w.Uvarint(wire.EventCookiesListed)
+			w.Int(req)
+			w.Strings(fields)
+			w.String("")
+		}), true)
+	case wire.CallSetCookie:
+		req, store := int(r.Int()), int(r.Int())
+		c := platform.Cookie{Name: r.String(), Value: r.String(), Domain: r.String(), Path: r.String()}
+		if s := r.String(); s != "" {
+			if t, err := time.Parse(time.RFC3339, s); err == nil {
+				c.Expires = t
+			}
+		}
+		c.Secure, c.HTTPOnly, c.SameSite = r.Bool(), r.Bool(), r.String()
+		f.mu.Lock()
+		f.cookies[store][platform.CookieKey{Name: c.Name, Domain: c.Domain, Path: c.Path}] = c
+		f.mu.Unlock()
+		deliver(encodeEvent(func(w *wire.Writer) {
+			w.Uvarint(wire.EventDataStoreDone)
+			w.Int(req)
+			w.String("")
+		}), true)
+	case wire.CallDeleteCookie:
+		req, store := int(r.Int()), int(r.Int())
+		key := platform.CookieKey{Name: r.String(), Domain: r.String(), Path: r.String()}
+		f.mu.Lock()
+		delete(f.cookies[store], key)
+		f.mu.Unlock()
+		deliver(encodeEvent(func(w *wire.Writer) {
+			w.Uvarint(wire.EventDataStoreDone)
+			w.Int(req)
+			w.String("")
+		}), true)
+	case wire.CallClearCookies:
+		req, store := int(r.Int()), int(r.Int())
+		f.mu.Lock()
+		f.cookies[store] = map[platform.CookieKey]platform.Cookie{}
+		f.mu.Unlock()
+		deliver(encodeEvent(func(w *wire.Writer) {
+			w.Uvarint(wire.EventDataStoreDone)
+			w.Int(req)
+			w.String("")
+		}), true)
+	case wire.CallClearBrowsingData:
+		req, store, types := int(r.Int()), int(r.Int()), platform.SiteData(r.Int())
+		f.mu.Lock()
+		f.cleared = append(f.cleared, types)
+		f.cookies[store] = map[platform.CookieKey]platform.Cookie{}
+		f.mu.Unlock()
+		deliver(encodeEvent(func(w *wire.Writer) {
+			w.Uvarint(wire.EventDataStoreDone)
+			w.Int(req)
+			w.String("")
+		}), true)
+	}
+}
+
+func (f *fakeStores) snapshot() (stores, windows []int) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return slices.Clone(f.stores), slices.Clone(f.windowSt)
+}
