+// Cookies round-trip through a store: set, list by URL, delete, clear.
+func TestCookieRoundTrip(t *testing.T) {
+	b, h := startBackend(t)
+	f := newFakeStores()
+	h.serve = f.serve
+
+	var store platform.DataStore
+	onMain(b, func() {
+		var err error
+		if store, err = b.App().NewDataStore(platform.DataStoreOptions{ID: "33333333-3333-4333-8333-333333333333"}); err != nil {
+			t.Errorf("NewDataStore: %v", err)
+		}
+	})
+	expires := time.Now().Add(time.Hour).UTC().Truncate(time.Second)
+	c := platform.Cookie{Name: "token", Value: "a=b", Domain: "example.com", Path: "/account",
+		Expires: expires, Secure: true, HTTPOnly: true, SameSite: "strict"}
+	onMain(b, func() {
+		b.App().SetCookie(store, c, func(err error) {
+			if err != nil {
+				t.Errorf("SetCookie: %v", err)
+			}
+		})
+	})
+	got := cookieList(t, b, store, "https://example.com/account")
+	if len(got) != 1 {
+		t.Fatalf("cookies = %+v, want one", got)
+	}
+	// The time wire format keeps whole seconds.
+	if !got[0].Expires.Equal(expires) || got[0].Name != "token" || got[0].Value != "a=b" ||
+		got[0].Domain != "example.com" || got[0].Path != "/account" || !got[0].Secure || !got[0].HTTPOnly || got[0].SameSite != "strict" {
+		t.Errorf("cookie = %+v, want %+v", got[0], c)
+	}
+	if got := cookieList(t, b, store, "https://other.example/account"); len(got) != 0 {
+		t.Errorf("a request to another host got %+v", got)
+	}
+	// An insecure request sends no Secure cookie.
+	if got := cookieList(t, b, store, "http://example.com/account"); len(got) != 0 {
+		t.Errorf("an http request got %+v", got)
+	}
+
+	onMain(b, func() {
+		b.App().DeleteCookie(store, platform.CookieKey{Name: "token", Domain: "example.com", Path: "/account"}, func(err error) {
+			if err != nil {
+				t.Errorf("DeleteCookie: %v", err)
+			}
+		})
+	})
+	if got := cookieList(t, b, store, "https://example.com/account"); len(got) != 0 {
+		t.Errorf("after Delete, cookies = %+v", got)
+	}
+
+	onMain(b, func() {
+		for _, n := range []string{"a", "b"} {
+			b.App().SetCookie(store, platform.Cookie{Name: n, Value: "1", Domain: "example.com", Path: "/"}, func(error) {})
+		}
+		b.App().ClearCookies(store, func(err error) {
+			if err != nil {
+				t.Errorf("ClearCookies: %v", err)
+			}
+		})
+	})
+	if got := cookieList(t, b, store, "https://example.com/"); len(got) != 0 {
+		t.Errorf("after Clear, cookies = %+v", got)
+	}
+}
