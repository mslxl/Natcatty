+// Every session's data store is its own, apart from the others', and a
+// page opens on the store the app chose.
+func TestDataStoreIsolation(t *testing.T) {
+	b, h := startBackend(t)
+	f := newFakeStores()
+	h.serve = f.serve
+
+	var s1, s2 platform.DataStore
+	onMain(b, func() {
+		var err error
+		if s1, err = b.App().NewDataStore(platform.DataStoreOptions{ID: "11111111-1111-4111-8111-111111111111"}); err != nil {
+			t.Errorf("NewDataStore: %v", err)
+		}
+		if s2, err = b.App().NewDataStore(platform.DataStoreOptions{ID: "22222222-2222-4222-8222-222222222222"}); err != nil {
+			t.Errorf("NewDataStore: %v", err)
+		}
+	})
+	stores, _ := f.snapshot()
+	if len(stores) != 2 || stores[0] == stores[1] {
+		t.Fatalf("stores = %v, want two distinct ones", stores)
+	}
+	onMain(b, func() {
+		b.NewWindow(&platform.WindowOptions{DataStore: s1}, &winHandler{})
+		b.NewWindow(&platform.WindowOptions{DataStore: s2}, &winHandler{})
+	})
+	_, windows := f.snapshot()
+	if !slices.Equal(windows, stores) {
+		t.Errorf("windows opened on stores %v, want %v", windows, stores)
+	}
+
+	// A cookie of one store is not one of the other.
+	onMain(b, func() {
+		b.App().SetCookie(s1, platform.Cookie{Name: "sid", Value: "one", Domain: "example.com", Path: "/", Secure: true, HTTPOnly: true, SameSite: "lax"}, func(err error) {
+			if err != nil {
+				t.Errorf("SetCookie: %v", err)
+			}
+		})
+	})
+	if got := cookieList(t, b, s1, "https://example.com/"); len(got) != 1 || got[0].Value != "one" {
+		t.Errorf("store 1 cookies = %+v", got)
+	}
+	if got := cookieList(t, b, s2, "https://example.com/"); len(got) != 0 {
+		t.Errorf("store 2 cookies = %+v, want none", got)
+	}
+}
