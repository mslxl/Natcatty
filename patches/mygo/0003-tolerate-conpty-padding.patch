+// clearMouseModes forgets every recorded mouse mode and the synthetic 1000,
+// as the library does on a reset.
+func (t *Terminal) clearMouseModes() {
+	t.mouse9, t.mouse1000, t.mouse1001, t.mouse1002, t.mouse1003 = false, false, false, false, false
+	t.synthetic1000 = false
+}
+
 // syncSyntheticMouseMode turns the C library's mode 1000 on or off to stand
-// for 1001, which it cannot keep. It leaves the mode alone once the program
-// asks for 1000 itself: the bit is then the program's.
+// for 1001, which it cannot keep.
+//
+// The mode is written as output bytes, because the library's mode API sets
+// the bit without telling the mouse encoder, which reads the parser's own
+// tracking mode and would then encode nothing. The write is deferred while
+// the parser holds a partial sequence or rune: raw bytes fed into it then
+// would abort the program's split CSI, and the encoder would stay dead.
+//
+// Once the program takes a mode of its own, the synthetic 1000 is dropped
+// without a reset write. The library's tracking mode is the mode of the last
+// mouse-mode sequence it read, not a combination of the bits: a 1000 reset
+// after 1002 or 1003 turns tracking off while their bits stay set, and the
+// encoder then reports nothing. Leaving the bit alone keeps the program's
+// mode in force.
 func (t *Terminal) syncSyntheticMouseMode() {
 	real := t.mouse9 || t.mouse1000 || t.mouse1002 || t.mouse1003
 	if t.mouse1001 && !real {
 		// Re-assert on every write, not just when the state flips: a 1000
 		// toggle later in the same output may have cleared the bit.
 		t.synthetic1000 = true
-		seq := []byte("\x1b[?1000h")
-		call(fnTerminalVTWrite, t.h, uintptr(unsafe.Pointer(&seq[0])), uintptr(len(seq)))
+		t.enableSyntheticMouseMode()
 		return
 	}
 	if !t.synthetic1000 {
 		return
 	}
-	if t.mouse1000 {
-		// The program turned 1000 on itself: the bit is now the program's.
-		// Dropping ownership without writing keeps it on, even while 1001
-		// stays on too.
+	if real {
+		// The program's own mode now takes the mouse.
 		t.synthetic1000 = false
 		return
 	}
+	t.disableSyntheticMouseMode()
+}
+
+// enableSyntheticMouseMode writes mode 1000 on, if the parser can take it now.
+// A deferred write stays pending, as synthetic1000 records, until the next
+// write finds the parser quiescent.
+func (t *Terminal) enableSyntheticMouseMode() {
+	if !t.parserQuiescent() {
+		return
+	}
+	t.writeSyntheticMouseMode([]byte("\x1b[?1000h"))
+}
+
+// disableSyntheticMouseMode writes mode 1000 off and forgets the synthetic
+// bit, but only once the write can be made: the bit stays pending until then.
+func (t *Terminal) disableSyntheticMouseMode() {
+	if !t.parserQuiescent() {
+		return
+	}
 	t.synthetic1000 = false
-	seq := []byte("\x1b[?1000l")
+	t.writeSyntheticMouseMode([]byte("\x1b[?1000l"))
+}
+
+func (t *Terminal) writeSyntheticMouseMode(seq []byte) {
 	call(fnTerminalVTWrite, t.h, uintptr(unsafe.Pointer(&seq[0])), uintptr(len(seq)))
+	runtime.KeepAlive(seq)
 }
 
 // Resize sets the size of the screen in cells, and of a cell in pixels.
@@ -401,8 +459,7 @@ func (t *Terminal) Cursor() (x, y int) {
 
