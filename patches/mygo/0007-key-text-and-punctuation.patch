diff --git a/ui/key_text_test.go b/ui/key_text_test.go
new file mode 100644
index 0000000..9629689
--- /dev/null
+++ b/ui/key_text_test.go
@@ -0,0 +1,44 @@
+package ui
+
+import (
+	"testing"
+
+	"github.com/egoist/mygo/internal/platform"
+)
+
+// TestKeyDownCarriesThePlatformText: a hardware key may carry the text the
+// platform composed for it, as Android's Alt-composed "ç" and a punctuation
+// key's character. Both the elements observing the focus and the one that
+// handles it see that text on the key down.
+func TestKeyDownCarriesThePlatformText(t *testing.T) {
+	var observed, handled []InputEvent
+	tt := NewTester(func(c *Context) {
+		Column(c).ObserveInput(func(ev InputEvent) {
+			if ev.Kind == InputKeyDown {
+				observed = append(observed, ev)
+			}
+		}).Children(func() {
+			Box(c).Size(100, 100).Focusable().AutoFocus().HandleInput(func(ev InputEvent) bool {
+				if ev.Kind == InputKeyDown {
+					handled = append(handled, ev)
+				}
+				return false
+			})
+		})
+	}, 200, 200)
+	tt.Frame()
+	tt.send(platform.SurfaceEvent{Kind: platform.KeyPressed, Key: platform.KeyUnknown, Text: "ç"})
+	tt.send(platform.SurfaceEvent{Kind: platform.KeyReleased, Key: platform.KeyUnknown})
+
+	for _, got := range []struct {
+		what   string
+		events []InputEvent
+	}{{"observed", observed}, {"handled", handled}} {
+		if len(got.events) != 1 {
+			t.Fatalf("%s %d key downs, want 1", got.what, len(got.events))
+		}
+		if ev := got.events[0]; ev.Key != KeyUnknown || ev.Text != "ç" {
+			t.Errorf("%s key down = key %v, text %q; want KeyUnknown, %q", got.what, ev.Key, ev.Text, "ç")
+		}
+	}
+}
