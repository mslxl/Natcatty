+package mobile
+
+import (
+	"testing"
+
+	"github.com/egoist/mygo/internal/mobile/wire"
+	"github.com/egoist/mygo/internal/platform"
+)
+
+// TestKeyOfPunctuation: the hosts name a punctuation key by the name MyGo
+// uses where a chord leaves no character, and by the character itself where
+// the key types one.
+func TestKeyOfPunctuation(t *testing.T) {
+	for _, c := range []struct {
+		name string
+		want platform.Key
+	}{
+		{"Comma", platform.KeyComma}, {",", platform.KeyComma},
+		{"Period", platform.KeyPeriod}, {".", platform.KeyPeriod},
+		{"Slash", platform.KeySlash}, {"/", platform.KeySlash},
+		{"Semicolon", platform.KeySemicolon}, {";", platform.KeySemicolon},
+		{"Quote", platform.KeyQuote}, {"'", platform.KeyQuote},
+		{"BracketLeft", platform.KeyBracketLeft}, {"[", platform.KeyBracketLeft},
+		{"BracketRight", platform.KeyBracketRight}, {"]", platform.KeyBracketRight},
+		{"Backslash", platform.KeyBackslash}, {"\\", platform.KeyBackslash},
+		{"Backquote", platform.KeyBackquote}, {"`", platform.KeyBackquote},
+		{"Minus", platform.KeyMinus}, {"-", platform.KeyMinus},
+		{"Equal", platform.KeyEqual}, {"=", platform.KeyEqual},
+	} {
+		if got := keyOf(c.name); got != c.want {
+			t.Errorf("keyOf(%q) = %v, want %v", c.name, got, c.want)
+		}
+	}
+}
+
+// TestKeyEventCarriesItsText: the text the host composed for a hardware key,
+// as Android's Alt-composed "ç", reaches the content's key event instead of
+// being dropped on the way. A release carries none, and still reaches it.
+func TestKeyEventCarriesItsText(t *testing.T) {
+	b, h := startBackend(t)
+	w, wh := surfaceWindow(t, b, h)
+	h.onUI(func() {
+		deliver(encodeEvent(func(wr *wire.Writer) {
+			wr.Uvarint(wire.EventKey)
+			wr.Int(w.id)
+			wr.Bool(true)
+			wr.String("c")
+			wr.String("ç")
+			wr.Int(int(platform.ModAlt))
+			wr.Bool(false)
+		}), true)
+		deliver(encodeEvent(func(wr *wire.Writer) {
+			wr.Uvarint(wire.EventKey)
+			wr.Int(w.id)
+			wr.Bool(false)
+			wr.String("c")
+			wr.String("")
+			wr.Int(int(platform.ModAlt))
+			wr.Bool(false)
+		}), true)
+	})
+	wh.mu.Lock()
+	defer wh.mu.Unlock()
+	var down, up *platform.SurfaceEvent
+	for i := range wh.events {
+		switch wh.events[i].Kind {
+		case platform.KeyPressed:
+			down = &wh.events[i]
+		case platform.KeyReleased:
+			up = &wh.events[i]
+		}
+	}
+	if down == nil || up == nil {
+		t.Fatalf("key events: down %v, up %v", down, up)
+	}
+	if down.Key != platform.KeyC || down.Text != "ç" {
+		t.Errorf("key down = key %v, text %q; want %v, %q", down.Key, down.Text, platform.KeyC, "ç")
+	}
+	if up.Key != platform.KeyC || up.Text != "" {
+		t.Errorf("key up = key %v, text %q; want %v, %q", up.Key, up.Text, platform.KeyC, "")
+	}
+}
